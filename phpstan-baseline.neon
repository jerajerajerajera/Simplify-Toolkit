parameters:
	ignoreErrors:
		-
			message: '#^Method Simplify\\Toolkit\\Filament\\Admin\\Pages\\ToolkitSettings\:\:getNavigationGroup\(\) never returns null so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: src/Filament/Admin/Pages/ToolkitSettings.php

		-
			message: '#^Called ''slice'' on Laravel collection, but could have been retrieved as a query\.$#'
			identifier: larastan.noUnnecessaryCollectionCall
			count: 1
			path: src/Services/AutomaticBackups.php

		-
			message: '#^Offset ''icon'' on array\{name\: string, version\: string, url\: string, icon\: string, download\: string\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Services/EmbedDetails.php

		-
			message: '#^Using nullsafe property access "\?\-\>icon" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 2
			path: src/Services/Packages.php

		-
			message: '#^Using nullsafe property access "\?\-\>key" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Services/Packages.php

		-
			message: '#^Using nullsafe property access "\?\-\>off_reason" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Services/Packages.php

		-
			message: '#^Using nullsafe property access "\?\-\>page" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 2
			path: src/Services/Packages.php

		-
			message: '#^Using nullsafe property access "\?\-\>source" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Services/Packages.php

		-
			message: '#^Using nullsafe property access "\?\-\>title" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 2
			path: src/Services/Packages.php

		-
			message: '#^Using nullsafe property access "\?\-\>features" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Services/ServerKind.php

		-
			message: '#^Using nullsafe property access on non\-nullable type App\\Models\\Egg\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Services/ServerKind.php

		-
			message: '#^Call to function is_string\(\) with string will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Services/Sources/Catalog.php

		-
			message: '#^Comparison operation "\<" between 0 and 1 is always true\.$#'
			identifier: smaller.alwaysTrue
			count: 1
			path: src/Services/StatusPing.php

		-
			message: '#^Comparison operation "\>" between \*NEVER\* and 2097152 results in an error\.$#'
			identifier: greater.invalid
			count: 1
			path: src/Services/StatusPing.php

		-
			message: '#^Method Simplify\\Toolkit\\Services\\StatusPing\:\:ask\(\) never returns string so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: src/Services/StatusPing.php

		-
			message: '#^Result of \|\| is always true\.$#'
			identifier: booleanOr.alwaysTrue
			count: 1
			path: src/Services/StatusPing.php

		-
			message: '#^Using nullsafe method call on non\-nullable type App\\Models\\Node\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Services/StatusPing.php

		-
			message: '#^Using nullsafe property access on non\-nullable type App\\Models\\Allocation\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 2
			path: src/Services/StatusPing.php
